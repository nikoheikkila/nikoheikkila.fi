{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	extends: [
		'config:best-practices',
		'helpers:pinGitHubActionDigestsToSemver',
		'security:openssf-scorecard',
		':automergeBranch',
		':automergeMinor',
		':automergeRequireAllStatusChecks',
		':combinePatchMinorReleases',
		':dependencyDashboard',
		// Lock file maintenance bumps transitive dependencies in bulk, bypassing the per-package release cooldown.
		':maintainLockFilesDisabled',
	],
	enabledManagers: [
		'bun',
		'mise',
		'github-actions',
		'terraform',
		'custom.regex',
	],
	schedule: [
		'every weekend',
	],
	// Hijacked releases are usually detected and yanked within days: never propose anything younger than a week.
	minimumReleaseAge: '7 days',
	// Do not even create a branch until the release age check passes.
	internalChecksFilter: 'strict',
	// Never run package lifecycle scripts inside Renovate.
	ignoreScripts: true,
	rangeStrategy: 'pin',
	osvVulnerabilityAlerts: true,
	dependencyDashboardOSVVulnerabilitySummary: 'unresolved',
	// Security fixes skip the schedule and cooldown, but always need a human review.
	vulnerabilityAlerts: {
		enabled: true,
		labels: [
			'security',
		],
		schedule: [
			'at any time',
		],
		minimumReleaseAge: null,
		automerge: false,
	},
	customManagers: [
		{
			customType: 'regex',
			description: 'Update versions annotated with `# renovate: datasource=… depName=…` in workflows and composite actions',
			managerFilePatterns: [
				'/(^|/)\\.github/(workflows|actions)/.+\\.ya?ml$/',
			],
			matchStrings: [
				'#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+[\\w-]+:\\s*["\']?(?<currentValue>[^\\s"\']+)',
			],
		},
	],
	packageRules: [
		{
			extends: [
				'monorepo:gatsby',
			],
			matchUpdateTypes: [
				'digest',
				'patch',
				'minor',
				'major',
			],
			groupName: 'Gatsby packages',
		},
		{
			description: 'Keep the mise Terraform pin and required_version in step',
			matchPackageNames: [
				'hashicorp/terraform',
			],
			groupName: 'Terraform CLI',
		},
		{
			description: 'Keep the mise Zizmor pin, zizmor-action and its version input in step',
			matchPackageNames: [
				'zizmorcore/zizmor',
				// Each action release only accepts the zizmor versions it ships lock files for.
				'zizmorcore/zizmor-action',
			],
			groupName: 'Zizmor',
		},
		{
			description: 'Keep the mise Wrangler pin and the wranglerVersion input of preview-cleanup.yml in step',
			matchPackageNames: [
				'wrangler',
			],
			groupName: 'Wrangler',
		},
		{
			description: 'The config validator must not get ahead of the schema the hosted Renovate app runs',
			matchManagers: [
				'bun',
			],
			matchDepNames: [
				'renovate',
			],
			minimumReleaseAge: '30 days',
			automerge: false,
		},
	],
}
