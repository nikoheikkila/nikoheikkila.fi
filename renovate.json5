{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	extends: [
		'config:best-practices',
		'helpers:pinGitHubActionDigestsToSemver',
		'security:openssf-scorecard',
		':automergeBranch',
		':automergeMinor',
		':automergeRequireAllStatusChecks',
		':combinePatchMinorReleases',
		':dependencyDashboard',
		// Lock file maintenance bumps transitive dependencies in bulk, bypassing the per-package release cooldown.
		':maintainLockFilesDisabled',
	],
	enabledManagers: [
		'bun',
		'mise',
		'github-actions',
		'terraform',
		'custom.regex',
	],
	timezone: 'Europe/Helsinki',
	schedule: [
		// Every day between 03:00 and 04:00
		'after 3am and before 4am',
	],
	// Hijacked releases are usually detected and yanked within days: never propose anything younger than a week.
	minimumReleaseAge: '7 days',
	// Do not even create a branch until the release age check passes.
	internalChecksFilter: 'strict',
	// Never run package lifecycle scripts inside Renovate.
	ignoreScripts: true,
	rangeStrategy: 'pin',
	osvVulnerabilityAlerts: true,
	dependencyDashboardOSVVulnerabilitySummary: 'unresolved',
	// Security fixes skip the schedule and cooldown, but always need a human review.
	vulnerabilityAlerts: {
		enabled: true,
		labels: [
			'security',
		],
		schedule: [
			'at any time',
		],
		minimumReleaseAge: null,
		automerge: false,
	},
	customManagers: [
		{
			customType: 'regex',
			description: 'Update versions annotated with `# renovate: datasource=… depName=…` in workflows and composite actions',
			managerFilePatterns: [
				'/(^|/)\\.github/(workflows|actions)/.+\\.ya?ml$/',
			],
			matchStrings: [
				'#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+[\\w-]+:\\s*["\']?(?<currentValue>[^\\s"\']+)',
			],
		},
	],
	packageRules: [
		{
			// Listed first so the more specific groups below (Gatsby, Wrangler) take precedence.
			description: 'Update all devDependencies in a single pull request',
			matchManagers: [
				'bun',
			],
			matchDepTypes: [
				'devDependencies',
			],
			groupName: 'devDependencies',
		},
		{
			extends: [
				'monorepo:gatsby',
			],
			matchUpdateTypes: [
				'digest',
				'patch',
				'minor',
				'major',
			],
			groupName: 'Gatsby packages',
		},
		{
			description: 'Keep Vitest packages on the same version',
			matchPackageNames: [
				'vitest',
				'@vitest/**',
				'!@vitest/browser-playwright',
				'vitest-browser-react',
			],
			groupName: 'Vitest',
		},
		{
			description: 'Keep Playwright and its integrations in step',
			matchPackageNames: [
				'@playwright/test',
				'playwright-bdd',
				'@axe-core/playwright',
				'@vitest/browser-playwright',
			],
			groupName: 'Playwright',
		},
		{
			description: 'Keep React, React DOM and their types in step',
			matchPackageNames: [
				'react',
				'react-dom',
				'@types/react',
				'@types/react-dom',
			],
			groupName: 'React',
		},
		{
			matchPackageNames: [
				'@fortawesome/**',
			],
			groupName: 'Font Awesome',
		},
		{
			matchPackageNames: [
				'react-markdown',
				'remark-*',
				'rehype-*',
			],
			groupName: 'React Markdown',
		},
		{
			matchPackageNames: [
				'@stryker-mutator/**',
			],
			groupName: 'Stryker',
		},
		{
			matchPackageNames: [
				'@commitlint/**',
			],
			groupName: 'Commitlint',
		},
		{
			matchPackageNames: [
				'happy-dom',
				'@happy-dom/**',
			],
			groupName: 'happy-dom',
		},
		{
			description: 'One pull request for all workflow action updates; the Zizmor group below takes precedence',
			matchManagers: [
				'github-actions',
			],
			groupName: 'GitHub Actions',
		},
		{
			description: 'Keep the mise Terraform pin and required_version in step',
			matchPackageNames: [
				'hashicorp/terraform',
			],
			groupName: 'Terraform CLI',
		},
		{
			description: 'Keep the mise Zizmor pin, zizmor-action and its version input in step',
			matchPackageNames: [
				'zizmorcore/zizmor',
				// Each action release only accepts the zizmor versions it ships lock files for.
				'zizmorcore/zizmor-action',
			],
			groupName: 'Zizmor',
		},
		{
			description: 'Keep the mise Wrangler pin and the wranglerVersion input of preview-cleanup.yml in step',
			matchPackageNames: [
				'wrangler',
			],
			groupName: 'Wrangler',
		},
		{
			description: 'The config validator must not get ahead of the schema the hosted Renovate app runs',
			matchManagers: [
				'bun',
			],
			matchDepNames: [
				'renovate',
			],
			minimumReleaseAge: '30 days',
			automerge: false,
		},
	],
}
